# Copy this file to .env beside run-all-services.ps1 and fill in values once.
# Alternatively select a file with -EnvFile D:\config\ecom.env.
# Existing environment variables override file values; explicit launcher parameters override both.
# Values are literal; optional surrounding quotes are removed. Use full-line comments only.
# Generate independent random secrets of at least 32 characters. Do not commit real secrets.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
ORDER_SYNC_KEY=
PAYMENT_SYNC_KEY=
FULFILLMENT_SYNC_KEY=
INVENTORY_SYNC_KEY=
ORDER_SERVICE_URL=http://localhost:3311
PAYMENT_SERVICE_URL=http://localhost:3314
FULFILLMENT_SERVICE_URL=http://localhost:3315
NOTIFICATION_SERVICE_URL=http://localhost:3317
# Review and provision schemas explicitly before startup. Runtime migrations stay disabled.
FLYWAY_ENABLED=false
SPRING_FLYWAY_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_SQL_INIT_MODE=never
