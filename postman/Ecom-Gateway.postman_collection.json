    {
      "name": "02 Security and missing routes",
      "item": [
        {
          "name": "Unknown route returns 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/__gateway_route_that_does_not_exist__",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unknown route is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Profile requires authentication",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/customer-profile/api/v1/profiles/me",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Missing token rejected\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid bearer token rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid-test-token"
              }
            ],
            "url": "{{gateway_url}}/customer-profile/api/v1/profiles/me",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Invalid token rejected\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 CORS",
      "item": [
        {
          "name": "Browser CORS preflight",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontend_origin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization,content-type"
              }
            ],
            "url": "{{gateway_url}}/org-access/api/auth/login",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Preflight accepted\", () => pm.expect(pm.response.code).to.be.oneOf([200,204]));",
                  "pm.test(\"Origin allowed\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(pm.environment.get(\"frontend_origin\")));",
                  "pm.test(\"POST allowed\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Methods\")).to.include(\"POST\"));",
                  "pm.test(\"Authorization header allowed\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Headers\").toLowerCase()).to.include(\"authorization\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Authentication - requires credentials",
      "item": [
        {
          "name": "Login - saves access_token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gateway_url}}/org-access/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"access_token\");",
                  "if (!pm.environment.get(\"username\") || !pm.environment.get(\"password\")) throw new Error(\"Set username and password in the selected Postman environment before running Authentication.\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Token returned and saved\", () => { const b = pm.response.json(); pm.expect(b.token).to.be.a(\"string\").and.not.empty; if (pm.response.code === 200) pm.environment.set(\"access_token\", b.token); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Authenticated me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/org-access/api/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Identity authenticated\", () => { const b = pm.response.json(); pm.expect(b.authenticated).to.eql(true); pm.expect(b.username).to.be.a(\"string\").and.not.empty; pm.expect(b.roles).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Authenticated validate",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/org-access/api/auth/validate",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Identity authenticated\", () => { const b = pm.response.json(); pm.expect(b.authenticated).to.eql(true); pm.expect(b.username).to.be.a(\"string\").and.not.empty; pm.expect(b.roles).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        }
      ]
