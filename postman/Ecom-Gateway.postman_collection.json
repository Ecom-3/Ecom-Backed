{
  "info": {
    "name": "Ecom Gateway Verification",
    "description": "Run Core routing, Security and CORS without credentials. Authentication requires an existing valid username/password in the selected environment. All requests go through the gateway. Health checks prove route reachability, not complete business workflows. Legacy unrelated routes are excluded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Core routing - no credentials",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/actuator/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Service is UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        },
